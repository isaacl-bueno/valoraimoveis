# ── Vercel (sem banco) ───────────────────────────────────────────────────────
# Só as variáveis acima bastam. Imóveis e usuários ficam em arquivo (/tmp).
# Não configure DATABASE_URL na Vercel, a menos que queira usar banco.

# ── Hostinger (com banco MySQL) — quando o cliente migrar ────────────────────
# DB_PROVIDER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=u123456789_valora
# DB_PASSWORD=sua_senha_mysql
# DB_NAME=u123456789_valora

# Forçar modo arquivo mesmo com banco configurado (opcional)
# USE_MEMORY_DB=true
