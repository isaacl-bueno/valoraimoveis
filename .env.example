# Credenciais do painel administrativo (obrigatório)
ADMIN_EMAIL=admin@valoraimoveis.com
ADMIN_PASSWORD=valora123
ADMIN_NAME=Administrador
ADMIN_SESSION_SECRET=troque-este-segredo-em-producao

# ── Vercel Blob (fotos persistentes na Vercel) ────────────────────────────────
# No painel Vercel: Storage → Blob → Connect to Project
# A Vercel injeta automaticamente (OIDC):
#   BLOB_READ_WRITE_TOKEN_STORE_ID  (ou BLOB_STORE_ID)
#   BLOB_READ_WRITE_TOKEN_WEBHOOK_PUBLIC_KEY
# Opcional: tipo do store (private = padrão na Vercel; public se criou store público)
# BLOB_ACCESS=private

# ── Vercel + Neon (PostgreSQL) ───────────────────────────────────────────────
# 1. Crie conta em https://neon.tech (grátis)
# 2. Crie um projeto e copie a connection string
# 3. Cole em DATABASE_URL na Vercel (Settings → Environment Variables)
# 4. Rode uma vez: npm run db:setup   (local, com DATABASE_URL no .env.local)
#    ou: POST /api/setup com header x-setup-secret = ADMIN_SESSION_SECRET
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Local sem banco (opcional — só para dev) ─────────────────────────────────
# USE_MEMORY_DB=true

# ── Hostinger (depois) — MySQL ───────────────────────────────────────────────
# DB_PROVIDER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=u123456789_valora
# DB_PASSWORD=sua_senha_mysql
# DB_NAME=u123456789_valora
