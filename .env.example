# Credenciais do painel administrativo
ADMIN_EMAIL=admin@valoraimoveis.com
ADMIN_PASSWORD=valora123
ADMIN_NAME=Administrador
ADMIN_SESSION_SECRET=troque-este-segredo-em-producao

# ── Hostinger (recomendado) — MySQL do hPanel ──────────────────────────────
# hPanel > Bancos de dados MySQL > criar banco e usuário
DB_PROVIDER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_valora
DB_PASSWORD=sua_senha_mysql
DB_NAME=u123456789_valora

# Ou use URL completa (alternativa):
# DATABASE_URL=mysql://usuario:senha@localhost:3306/nome_do_banco

# ── Vercel / Neon (alternativa) — PostgreSQL ───────────────────────────────
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require

# Uploads persistentes (Hostinger VPS/local = automático; Vercel = temporário)
# PERSIST_UPLOADS=true
